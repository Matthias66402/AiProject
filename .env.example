OPENAI_API_KEY=
# Optional: ohne Wert werden die darüber erreichbaren Modelle in der KI-Assistent-Auswahl
# automatisch ausgeblendet (siehe app.py).
GROQ_API_KEY=

# Optional: KI-Logging mit Langfuse (siehe README). Ohne Keys kein Tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=aiproject
DB_USER=postgres
DB_PASSWORD=

SECRET_KEY=

# 1 = Flask-Debug-Modus (Reloader + Debugger) für lokale Entwicklung, nie öffentlich.
# Im Docker-Compose-Setup bereits gesetzt.
FLASK_DEBUG=1
